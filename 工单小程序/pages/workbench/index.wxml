<view class="page">
<view class="row"><text class="muted">当前登录：{{loginName}}</text><text class="preview" bindtap="logout">退出登录</text></view>
<view class="brand"><view class="eyebrow">全球站 · 仓内作业</view><view class="title">{{tab === 'home' ? '附加项报工' : tab === 'records' ? '报工记录' : '人员产量'}}</view><view class="muted">每一笔作业，都有据可查</view></view>
<view class="notice">演示模式 · 数据仅保存在当前设备，不计正式产量</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{tab === 'home'}}">
<view class="metrics"><view><view class="number">{{count}}</view><view class="muted">演示报工笔数</view></view><view><view class="number">{{total}}</view><view class="muted">各附加项累计件次</view></view></view>
<view class="card"><view class="section-title">开始一笔报工</view><view class="muted">扫描商品二维码，或输入商品 ID</view><button class="primary scan" bindtap="scan">扫描商品二维码</button><view class="search"><input class="input" value="{{code}}" bindinput="inputCode" placeholder="输入商品 ID" confirm-type="search" bindconfirm="search"/><button class="small" bindtap="search">查询</button></view><view class="demo-links"><text data-code="DDEMO001" bindtap="demo">普通商品</text><text data-code="DDEMO002" bindtap="demo">无附加项</text><text data-code="DDEMO003" bindtap="demo">无正品</text></view></view>
<block wx:if="{{product}}">
<view class="card"><view class="row"><view class="section-title">{{product.name}}</view><text class="badge">正品 {{product.good}}</text></view><view class="muted">{{product.id}} · 演示商品</view><picker range="{{employees}}" value="{{employee}}" bindchange="chooseEmployee"><view class="employee">实际处理人 <text>{{employees[employee]}}　›</text></view></picker><view class="muted">附加项可报总量以正品数为上限</view></view>
<view wx:if="{{!product.items.length}}" class="empty">此商品未配置附加项，无需报工。</view>
<view wx:if="{{product.good === 0}}" class="notice">当前正品数为 0，暂不可报工。</view>
<view class="card" wx:for="{{product.items}}" wx:key="id"><view class="row"><view class="section-title">{{item.name}}</view><text class="badge">{{item.status}}</text></view><view class="quantities"><view>可报总量<text class="quantity-value">{{product.good}}</text></view><view>累计已报<text class="quantity-value">{{item.reported}}</text></view><view>剩余未报<text class="quantity-value green">{{item.remaining}}</text></view></view><view class="search"><input class="input" type="number" placeholder="本次完成数量" value="{{item.input}}" data-id="{{item.id}}" bindinput="quantity" disabled="{{!item.remaining || submitting}}"/><button class="primary small" data-id="{{item.id}}" bindtap="submit" disabled="{{!item.remaining || submitting}}">确认报工</button></view><view wx:if="{{item.preview}}" class="preview" data-name="{{item.name}}" bindtap="preview">查看{{item.name}}预览 ›</view></view>
<button class="secondary" bindtap="adjust" disabled="{{submitting}}">演示操作：正品数增加 2</button>
</block></block>
<block wx:elif="{{tab === 'records'}}"><view wx:if="{{filterLabel}}" class="notice">{{filterLabel}} <text bindtap="allRecords">查看全部</text></view><view wx:if="{{!records.length}}" class="empty">暂无演示报工记录<view class="muted">选择普通商品，完成第一笔报工</view></view><view class="card" wx:for="{{records}}" wx:key="id"><view class="row"><view class="section-title">{{item.itemName}}</view><text class="green">+{{item.quantity}} 件</text></view><view>{{item.productName}} · {{item.productId}}</view><view class="record-bottom">{{item.employee}}<text>{{item.time}}</text></view></view></block>
<block wx:else><view class="summary-note muted">按日期、处理人及附加项汇总，点击查看流水。</view><view wx:if="{{!summary.length}}" class="empty">暂无人员产量<view class="muted">完成演示报工后自动汇总</view></view><view class="card" wx:for="{{summary}}" wx:key="index" data-index="{{index}}" bindtap="filterSummary"><view class="row"><view class="section-title">{{item.employee}} · {{item.itemName}}</view><text class="green">{{item.quantity}} 件 ›</text></view><view class="muted">{{item.date}}</view></view></block>
<view class="footnote">人员报工独立记录，不改变现有清算及出入库状态</view>
<view class="nav"><view class="nav-item {{tab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="changeTab">工作台</view><view class="nav-item {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="changeTab">报工记录</view><view class="nav-item {{tab === 'summary' ? 'active' : ''}}" data-tab="summary" bindtap="changeTab">人员产量</view></view>
</view>
