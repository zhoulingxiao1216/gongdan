.page{min-height:100vh;background:#f3f6f5;color:#172f2b;padding:36rpx 28rpx 180rpx;box-sizing:border-box;font-size:28rpx}.brand{padding:12rpx 8rpx 30rpx}.eyebrow{font-size:24rpx;color:#598077;letter-spacing:3rpx}.title{font-size:48rpx;font-weight:700;margin:14rpx 0}.muted{font-size:24rpx;color:#71817b;line-height:1.7}.notice{background:#fff4dc;color:#795921;font-size:24rpx;line-height:1.6;padding:20rpx 24rpx;border-radius:16rpx;margin-bottom:24rpx}.error{background:#fff0ee;color:#a4372d;padding:24rpx;border-radius:16rpx;margin-bottom:24rpx}.metrics{display:flex;justify-content:space-around;padding:12rpx 0 30rpx}.number{font-size:48rpx;font-weight:700}.card{background:#fff;border:1rpx solid #e4ece8;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.section-title{font-size:30rpx;font-weight:600;line-height:1.5}.primary{background:#16745f;color:white;border-radius:14rpx;font-size:28rpx}.scan{margin:26rpx 0 20rpx;line-height:92rpx}.search{display:flex;gap:16rpx;align-items:center}.input{flex:1;min-width:0;background:#f3f6f5;padding:20rpx;border-radius:12rpx;height:44rpx}.small{font-size:26rpx;padding:0 24rpx;line-height:84rpx;margin:0}.demo-links{display:flex;justify-content:space-between;color:#237860;font-size:24rpx;margin-top:26rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-bottom:14rpx}.badge{font-size:23rpx;color:#23765e;background:#edf6f1;padding:8rpx 14rpx;border-radius:8rpx;flex-shrink:0}.employee{display:flex;justify-content:space-between;padding:26rpx 0;margin-top:12rpx;border-top:1rpx solid #edf1ee}.quantities{display:flex;justify-content:space-between;padding:20rpx 0 28rpx;color:#748078;font-size:23rpx}.quantity-value{display:block;font-size:36rpx;font-weight:600;color:#283e34;margin-top:8rpx}.green,.quantities .green{color:#16745f;font-weight:600}.preview{color:#22705c;font-size:25rpx;padding-top:26rpx}.secondary{font-size:25rpx;color:#65736b;background:#e7ece8;border-radius:14rpx}.empty{text-align:center;padding:70rpx 20rpx;line-height:2;background:white;border-radius:20rpx}.record-bottom{display:flex;justify-content:space-between;margin-top:24rpx;font-size:23rpx;color:#728078}.summary-note{padding:0 8rpx 24rpx}.footnote{font-size:22rpx;color:#85918b;text-align:center;line-height:1.7;margin-top:34rpx}.nav{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1rpx solid #e4ece8;display:flex;padding:24rpx 12rpx calc(24rpx + env(safe-area-inset-bottom));z-index:10}.nav-item{flex:1;text-align:center;font-size:27rpx;color:#7a8880;padding:10rpx 0}.active{font-weight:700;color:#16745f}
