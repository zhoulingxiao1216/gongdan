.login-page{min-height:100vh;box-sizing:border-box;padding:42rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));background:#f3f6f5;color:#183c32;font-size:28rpx}.brand{display:flex;align-items:center;gap:18rpx}.brand-mark{height:68rpx;width:68rpx;line-height:68rpx;text-align:center;border-radius:20rpx;background:#16745f;color:#fff;font-size:34rpx;font-weight:700}.brand-name{font-size:30rpx;font-weight:700}.brand-caption{font-size:22rpx;color:#72837b;margin-top:4rpx}.intro{padding:52rpx 0 36rpx}.eyebrow{font-size:24rpx;color:#598077;letter-spacing:2rpx}.title{font-size:58rpx;line-height:1.3;font-weight:700;margin:18rpx 0}.description{font-size:26rpx;color:#6a7b73;line-height:1.8}.login-card{padding:30rpx;background:#fff;border:1rpx solid #e2ebe6;border-radius:28rpx}.card-heading{font-size:32rpx;font-weight:700}.card-caption{font-size:23rpx;color:#72837b;line-height:1.6;margin:10rpx 0 24rpx}.identity{display:flex;align-items:center;gap:20rpx;padding:22rpx;border:2rpx solid #e7eee9;border-radius:18rpx;margin-bottom:18rpx}.selected{border-color:#16745f;background:#f0f8f3}.avatar{width:66rpx;height:66rpx;line-height:66rpx;text-align:center;background:#e5eee8;border-radius:16rpx;font-size:30rpx;color:#306452;font-weight:600}.identity-info{flex:1}.identity-name{font-size:27rpx;font-weight:600}.identity-code{font-size:22rpx;color:#7b8a81;margin-top:7rpx}.radio{width:30rpx;height:30rpx;border:2rpx solid #a9bcb0;border-radius:50%;display:flex;align-items:center;justify-content:center}.selected .radio{border-color:#16745f}.radio-dot{width:18rpx;height:18rpx;background:#16745f;border-radius:50%}.login-button{background:#16745f;color:#fff;border-radius:16rpx;line-height:94rpx;font-size:29rpx;margin-top:28rpx;font-weight:600}.help{text-align:center;color:#397862;padding-top:26rpx;font-size:24rpx}.error{color:#b44535;background:#fff1ed;padding:18rpx;line-height:1.6;font-size:24rpx;border-radius:12rpx}.demo-note{padding:28rpx 8rpx;font-size:23rpx;color:#7b8274;line-height:1.8}.note-title{color:#69745f;font-weight:600;margin-bottom:6rpx}.footer{text-align:center;color:#92a097;font-size:22rpx;padding:12rpx 0}
